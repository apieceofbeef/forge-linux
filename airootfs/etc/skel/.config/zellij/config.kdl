// ~/.config/zellij/config.kdl
//
// FORGE Linux default Zellij configuration.

theme              "forge"
default_shell      "zsh"
default_layout     "compact"
pane_frames        false
simplified_ui      false
mouse_mode         true
copy_on_select     true
copy_command       "wl-copy"
copy_clipboard     "system"
scrollback_lines_to_serialize 10000
scroll_buffer_size 100000
mirror_session     false
ui {
    pane_frames {
        rounded_corners      true
        hide_session_name    false
    }
}

themes {
    forge {
        fg          "#e8e6df"
        bg          "#0d0e10"
        black       "#15171b"
        red         "#ef4444"
        green       "#22c55e"
        yellow      "#eab308"
        blue        "#3b82f6"
        magenta     "#a855f7"
        cyan        "#06b6d4"
        white       "#e8e6df"
        orange      "#f59e0b"
    }
}

plugins {
    tab-bar     location="zellij:tab-bar"
    status-bar  location="zellij:status-bar"
    compact-bar location="zellij:compact-bar"
}

load_plugins {
    "zellij:compact-bar"
}

// ------------------------------------------------------------------ keys ---
keybinds clear-defaults=true {
    normal {
        // Modes
        bind "Ctrl p" { SwitchToMode "Pane";    }
        bind "Ctrl t" { SwitchToMode "Tab";     }
        bind "Ctrl s" { SwitchToMode "Scroll";  }
        bind "Ctrl o" { SwitchToMode "Session"; }
        bind "Ctrl r" { SwitchToMode "Resize";  }
        bind "Ctrl h" { SwitchToMode "Move";    }
        bind "Ctrl g" { SwitchToMode "Locked";  }
        bind "Ctrl q" { Quit; }

        // Direct pane navigation -- works in normal mode without a mode change.
        bind "Alt h" { MoveFocusOrTab "Left";  }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus     "Down";   }
        bind "Alt k" { MoveFocus     "Up";     }
        bind "Alt n" { NewPane;                }
        bind "Alt v" { NewPane "Right";        }
        bind "Alt s" { NewPane "Down";         }
        bind "Alt x" { CloseFocus;             }
        bind "Alt f" { ToggleFloatingPanes;    }
        bind "Alt z" { ToggleFocusFullscreen;  }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -"         { Resize "Decrease"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    pane {
        bind "h" "Left"  { MoveFocus "Left";  }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down"  { MoveFocus "Down";  }
        bind "k" "Up"    { MoveFocus "Up";    }
        bind "n"         { NewPane;            SwitchToMode "Normal"; }
        bind "v"         { NewPane "Right";    SwitchToMode "Normal"; }
        bind "s"         { NewPane "Down";     SwitchToMode "Normal"; }
        bind "x"         { CloseFocus;         SwitchToMode "Normal"; }
        bind "f"         { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "z"         { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "w"         { ToggleFloatingPanes;  SwitchToMode "Normal"; }
        bind "p"         { TogglePaneFrames;   }
        bind "Esc" "Ctrl p" "Enter" { SwitchToMode "Normal"; }
    }

    tab {
        bind "h" "Left"  { GoToPreviousTab;  }
        bind "l" "Right" { GoToNextTab;      }
        bind "n"         { NewTab; SwitchToMode "Normal"; }
        bind "x"         { CloseTab; SwitchToMode "Normal"; }
        bind "r"         { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Esc" "Ctrl t" "Enter" { SwitchToMode "Normal"; }
    }

    resize {
        bind "h" { Resize "Left";  }
        bind "l" { Resize "Right"; }
        bind "j" { Resize "Down";  }
        bind "k" { Resize "Up";    }
        bind "+" "=" { Resize "Increase"; }
        bind "-"     { Resize "Decrease"; }
        bind "Esc" "Ctrl r" "Enter" { SwitchToMode "Normal"; }
    }

    move {
        bind "h" "Left"  { MovePane "Left";  }
        bind "l" "Right" { MovePane "Right"; }
        bind "j" "Down"  { MovePane "Down";  }
        bind "k" "Up"    { MovePane "Up";    }
        bind "Esc" "Ctrl h" "Enter" { SwitchToMode "Normal"; }
    }

    scroll {
        bind "j" "Down"  { ScrollDown; }
        bind "k" "Up"    { ScrollUp;   }
        bind "Ctrl d"    { HalfPageScrollDown; }
        bind "Ctrl u"    { HalfPageScrollUp;   }
        bind "g"         { ScrollToTop;    }
        bind "G"         { ScrollToBottom; }
        bind "/"         { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Esc" "Ctrl s" "Enter" { SwitchToMode "Normal"; }
    }

    search {
        bind "n" { Search "Down"; }
        bind "N" { Search "Up";   }
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Esc"   { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "Esc" "Ctrl o" "Enter" { SwitchToMode "Normal"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab;  SwitchToMode "Tab"; }
        bind "Enter" { SwitchToMode "Tab"; }
    }
}
