# ~/.config/dunst/dunstrc
#
# FORGE Linux -- dunst notification daemon configuration.
# Documentation: https://github.com/dunst-project/dunst/wiki/Configuration

[global]
    monitor                 = 0
    follow                  = mouse

    width                   = (300, 460)
    height                  = (0, 200)
    origin                  = top-right
    offset                  = 14x14
    scale                   = 0
    notification_limit      = 5

    progress_bar            = true
    progress_bar_height     = 8
    progress_bar_frame_width = 1
    progress_bar_min_width  = 150
    progress_bar_max_width  = 300

    indicate_hidden         = yes
    transparency            = 10
    text_icon_padding       = 8
    separator_height        = 2
    padding                 = 12
    horizontal_padding      = 14
    frame_width             = 2
    frame_color             = "#f59e0b"
    separator_color         = frame
    sort                    = yes
    idle_threshold          = 120

    font                    = JetBrainsMono Nerd Font 12
    line_height             = 1
    markup                  = full
    format                  = "<b>%a — %s</b>\n%b"
    alignment               = left
    vertical_alignment      = center
    show_age_threshold      = 60
    ellipsize               = middle
    ignore_newline          = no
    stack_duplicates        = true
    hide_duplicate_count    = false
    show_indicators         = yes

    icon_position           = left
    min_icon_size           = 24
    max_icon_size           = 32
    enable_recursive_icon_lookup = true
    icon_theme              = "Adwaita, hicolor"
    icon_corner_radius      = 6

    sticky_history          = yes
    history_length          = 20

    dmenu                   = /usr/bin/rofi -dmenu -p dunst
    browser                 = /usr/bin/xdg-open

    always_run_script       = true
    title                   = Dunst
    class                   = Dunst
    corner_radius           = 10
    ignore_dbusclose        = false
    layer                   = overlay
    force_xwayland          = false
    force_xinerama          = false

    mouse_left_click        = close_current
    mouse_middle_click      = do_action, close_current
    mouse_right_click       = close_all

[experimental]
    per_monitor_dpi = false

# ----------------------------------------------------------------------- urgency
[urgency_low]
    background              = "#111318"
    foreground              = "#94a3b8"
    frame_color             = "#475569"
    timeout                 = 4
    default_icon            = dialog-information

[urgency_normal]
    background              = "#111318"
    foreground              = "#e8e6df"
    frame_color             = "#f59e0b"
    timeout                 = 5
    default_icon            = dialog-information

[urgency_critical]
    background              = "#111318"
    foreground              = "#ffffff"
    frame_color             = "#ef4444"
    timeout                 = 0
    default_icon            = dialog-error

# ----------------------------------------------------------------------- rules
[fullscreen_show_critical]
    msg_urgency  = critical
    fullscreen   = pushback

[screenshot]
    appname      = "grim"
    new_icon     = "camera-photo"

[shortcuts]
    close                   = ctrl+space
    close_all               = ctrl+shift+space
    history                 = ctrl+grave
    context                 = ctrl+shift+period
