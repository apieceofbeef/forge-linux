# ~/.config/ghostty/config
#
# FORGE Linux default Ghostty terminal configuration.
# Documentation: https://ghostty.org/docs/config/reference

###############################################################################
# Font
###############################################################################
font-family            = JetBrainsMono Nerd Font
font-family-bold       = JetBrainsMono Nerd Font Bold
font-family-italic     = JetBrainsMono Nerd Font Italic
font-family-bold-italic = JetBrainsMono Nerd Font Bold Italic
font-size              = 13
font-feature           = +ss01
font-feature           = +ss02
font-feature           = +ss03
font-feature           = +cv02
font-feature           = +cv16
font-feature           = +zero
font-thicken           = true
adjust-cell-height     = 8%

###############################################################################
# Window / chrome
###############################################################################
window-decoration      = false
window-padding-x       = 12
window-padding-y       = 8
window-padding-balance = true
window-padding-color   = background
window-theme           = ghostty
window-save-state      = always
window-inherit-working-directory = true
window-inherit-font-size         = true
gtk-titlebar           = false
gtk-tabs-location      = top
gtk-wide-tabs          = false
gtk-single-instance    = true
confirm-close-surface  = false
quit-after-last-window-closed = true

###############################################################################
# Visual
###############################################################################
background-opacity     = 0.94
background-blur-radius = 24
unfocused-split-opacity = 0.85
cursor-style           = block
cursor-style-blink     = false
cursor-color           = f59e0b
cursor-text            = 0d0e10
mouse-hide-while-typing = true
bold-is-bright         = false
minimum-contrast       = 1.05
selection-invert-fg-bg = false

###############################################################################
# Behaviour
###############################################################################
scrollback-limit       = 100000
copy-on-select         = clipboard
clipboard-read         = allow
clipboard-write        = allow
clipboard-paste-protection = true
mouse-scroll-multiplier = 1.4
working-directory      = inherit
shell-integration      = zsh
shell-integration-features = cursor,sudo,title
term                   = xterm-ghostty

###############################################################################
# FORGE color palette (matches Hyprland / Waybar / Helix)
###############################################################################
background = 0d0e10
foreground = e8e6df

cursor-color = f59e0b
selection-background = 2c2f37
selection-foreground = e8e6df

# Normal (0-7)
palette = 0=#15171b
palette = 1=#ef4444
palette = 2=#22c55e
palette = 3=#f59e0b
palette = 4=#3b82f6
palette = 5=#a855f7
palette = 6=#06b6d4
palette = 7=#cbd5e1

# Bright (8-15)
palette = 8=#475569
palette = 9=#f87171
palette = 10=#4ade80
palette = 11=#fbbf24
palette = 12=#60a5fa
palette = 13=#c084fc
palette = 14=#22d3ee
palette = 15=#f8fafc

###############################################################################
# Keybindings (additions; built-ins remain active)
###############################################################################
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+enter=toggle_fullscreen
keybind = ctrl+shift+f=write_screen_file:open
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
