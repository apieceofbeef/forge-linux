// /etc/forge/fastfetch.jsonc -- FORGE Linux system info display.
//
// Used by the default zshrc greeting and can be invoked directly:
//
//     fastfetch --config /etc/forge/fastfetch.jsonc
//
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type":      "file",
        "source":    "/etc/forge/logo.txt",
        "padding":   { "left": 2, "right": 4, "top": 1 },
        "color":     { "1": "yellow" }
    },

    "display": {
        "separator":     " │ ",
        "color":         { "keys": "yellow", "title": "green" },
        "constants":     [],
        "key": {
            "type":      "icon",
            "paddingLeft": 1
        }
    },

    "modules": [
        {
            "type":     "title",
            "format":   "{user-name}{color1}@{color2}{host-name}"
        },
        "separator",
        { "type": "os",         "key": "{icon}  OS"        },
        { "type": "kernel",     "key": "  Kernel"        },
        { "type": "uptime",     "key": "󰔚  Uptime"        },
        { "type": "packages",   "key": "󰏖  Packages"      },
        { "type": "shell",      "key": "  Shell"         },
        { "type": "display",    "key": "󰍹  Display"       },
        { "type": "wm",         "key": "  WM"            },
        { "type": "terminal",   "key": "  Terminal"      },
        { "type": "cpu",        "key": "  CPU",          "showPeCoreCount": true },
        { "type": "gpu",        "key": "󰢮  GPU"           },
        { "type": "memory",     "key": "  Memory"        },
        { "type": "swap",       "key": "  Swap"          },
        { "type": "disk",       "key": "  Disk",         "folders": "/:/home" },
        { "type": "battery",    "key": "󰂄  Battery"       },
        { "type": "locale",     "key": "  Locale"        },
        "separator",
        { "type": "colors",     "paddingLeft": 2, "symbol": "circle" }
    ]
}
