#!/usr/bin/env bash
#
# forge-install -- interactive installer for FORGE Linux.
#
# Boot the live ISO, log in as forge/forge, then run:
#
#     sudo forge-install
#
# This script walks the user through partitioning, filesystem choice,
# locale/timezone, account creation, optional extras, then performs the
# install end-to-end (pacstrap + chroot configuration + GRUB).
#

set -Eeuo pipefail
shopt -s extglob

################################################################################
# Globals
################################################################################
readonly LOG_FILE="/tmp/forge-install.log"
readonly DEFAULT_LOCALE="en_US.UTF-8"
readonly DEFAULT_KEYMAP="us"
readonly DEFAULT_TZ="UTC"
readonly MNT="/mnt"

DISK=""
FS=""                 # btrfs | ext4
HOSTNAME=""
USERNAME=""
PASSWORD=""
ROOT_PASSWORD=""
TIMEZONE="$DEFAULT_TZ"
LOCALE="$DEFAULT_LOCALE"
KEYMAP="$DEFAULT_KEYMAP"
INSTALL_DOCKER=1
INSTALL_BLUETOOTH=1
INSTALL_PRINTING=0
STEP_NUM=0
TOTAL_STEPS=12

################################################################################
# Logging / colour
################################################################################
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_AMBER=$'\033[38;2;245;158;11m'
    C_GREEN=$'\033[38;2;34;197;94m'
    C_RED=$'\033[38;2;239;68;68m'
    C_BLUE=$'\033[38;2;59;130;246m'
    C_YELLOW=$'\033[38;2;234;179;8m'
    C_MUTED=$'\033[38;2;148;163;184m'
else
    C_RESET= C_BOLD= C_DIM= C_AMBER= C_GREEN= C_RED= C_BLUE= C_YELLOW= C_MUTED=
fi

log()  { printf '[%s] %s\n' "$(date +'%H:%M:%S')" "$*" | tee -a "$LOG_FILE" >&2; }
say()  { printf '%s%s[forge]%s %s\n' "$C_AMBER" "$C_BOLD" "$C_RESET" "$*"; log "$*"; }
ok()   { printf '%s%s[ ok ]%s %s\n' "$C_GREEN" "$C_BOLD" "$C_RESET" "$*"; log "OK: $*"; }
warn() { printf '%s%s[warn]%s %s\n' "$C_YELLOW" "$C_BOLD" "$C_RESET" "$*"; log "WARN: $*"; }
err()  { printf '%s%s[fail]%s %s\n' "$C_RED" "$C_BOLD" "$C_RESET" "$*" >&2; log "ERR: $*"; }
die()  { err "$*"; exit 1; }

step() {
    STEP_NUM=$((STEP_NUM + 1))
    printf '\n%s%s━━━ [%d/%d] %s ━━━%s\n' \
        "$C_AMBER" "$C_BOLD" "$STEP_NUM" "$TOTAL_STEPS" "$*" "$C_RESET"
    log "STEP $STEP_NUM/$TOTAL_STEPS: $*"
}

banner() {
    cat <<EOF
${C_AMBER}${C_BOLD}
  ┌──────────────────────────────────────────────────────┐
  │           ⬡  FORGE Linux interactive installer       │
  └──────────────────────────────────────────────────────┘
${C_RESET}${C_MUTED}  Log: ${LOG_FILE}${C_RESET}

EOF
}

trap '_cleanup $?' EXIT
_cleanup() {
    local rc="$1"
    if (( rc != 0 )); then
        err "Installer exited with code $rc; see $LOG_FILE"
    fi
    # Best-effort unmount.
    if mountpoint -q "$MNT/boot/efi"; then umount -R "$MNT/boot/efi" || true; fi
    if mountpoint -q "$MNT";           then umount -R "$MNT"           || true; fi
}

################################################################################
# Pre-flight
################################################################################
preflight() {
    (( EUID == 0 )) || die "forge-install must be run as root"
    [[ -f /etc/arch-release || -f /etc/os-release ]] || warn "non-Arch host detected; continuing anyway"
    ping -c1 -W2 archlinux.org >/dev/null 2>&1 || warn "network looks down -- pacstrap will fail"

    # Bootmode detection.
    if [[ -d /sys/firmware/efi/efivars ]]; then
        BOOTMODE="uefi"
    else
        BOOTMODE="bios"
    fi
    log "boot mode: $BOOTMODE"
    : > "$LOG_FILE"
}

################################################################################
# Prompts
################################################################################
ask() {
    local prompt="$1" default="${2-}" reply
    if [[ -n $default ]]; then
        printf '%s%s%s [%s%s%s]: ' "$C_AMBER" "$prompt" "$C_RESET" "$C_GREEN" "$default" "$C_RESET"
    else
        printf '%s%s%s: ' "$C_AMBER" "$prompt" "$C_RESET"
    fi
    IFS= read -r reply
    printf '%s\n' "${reply:-$default}"
}

ask_secret() {
    local prompt="$1" reply
    while :; do
        printf '%s%s%s: ' "$C_AMBER" "$prompt" "$C_RESET"
        IFS= read -rs reply; echo
        [[ -n $reply ]] || { warn "value cannot be empty"; continue; }
        local confirm
        printf '%s%s (confirm)%s: ' "$C_AMBER" "$prompt" "$C_RESET"
        IFS= read -rs confirm; echo
        if [[ $reply == "$confirm" ]]; then
            printf '%s\n' "$reply"
            return
        fi
        warn "values do not match; try again"
    done
}

confirm() {
    local prompt="$1" reply
    while :; do
        printf '%s%s%s [y/N]: ' "$C_AMBER" "$prompt" "$C_RESET"
        IFS= read -r reply
        case "${reply,,}" in
            y|yes)      return 0 ;;
            n|no|"")    return 1 ;;
        esac
    done
}

################################################################################
# Step 1: disk
################################################################################
select_disk() {
    step "Select target disk"
    say  "All data on the chosen disk will be ERASED."
    echo
    lsblk -dpno NAME,SIZE,MODEL,TRAN | column -t
    echo
    while :; do
        DISK="$(ask 'Target disk (e.g. /dev/sda or /dev/nvme0n1)')"
        if [[ -b $DISK ]]; then
            ok "Using $DISK"
            return
        fi
        warn "not a block device: $DISK"
    done
}

################################################################################
# Step 2: filesystem
################################################################################
select_fs() {
    step "Filesystem"
    cat <<EOF
  ${C_BOLD}1)${C_RESET}  btrfs (recommended): @ / @home / @snapshots / @var subvolumes
  ${C_BOLD}2)${C_RESET}  ext4 (classic, fast, no snapshots)
EOF
    while :; do
        local choice
        choice="$(ask 'Choice' '1')"
        case "$choice" in
            1|btrfs) FS=btrfs; ok "Selected btrfs"; return ;;
            2|ext4)  FS=ext4;  ok "Selected ext4";  return ;;
        esac
        warn "invalid choice"
    done
}

################################################################################
# Step 3: locale / timezone / keymap
################################################################################
select_locale() {
    step "Locale, timezone, keymap"
    TIMEZONE="$(ask 'Timezone (e.g. Europe/Berlin)' "$(timedatectl show -p Timezone --value 2>/dev/null || echo $DEFAULT_TZ)")"
    LOCALE="$(ask 'Locale' "$DEFAULT_LOCALE")"
    KEYMAP="$(ask 'Console keymap' "$DEFAULT_KEYMAP")"
}

################################################################################
# Step 4: hostname + user
################################################################################
select_user() {
    step "Hostname and user account"
    while :; do
        HOSTNAME="$(ask 'Hostname' 'forge')"
        [[ $HOSTNAME =~ ^[a-z0-9][-a-z0-9]{0,62}$ ]] && break
        warn "invalid hostname"
    done
    while :; do
        USERNAME="$(ask 'Primary username' 'forge')"
        [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
        warn "invalid username"
    done
    PASSWORD="$(ask_secret "Password for $USERNAME")"
    ROOT_PASSWORD="$(ask_secret 'Password for root')"
}

################################################################################
# Step 5: extras
################################################################################
select_extras() {
    step "Optional extras"
    INSTALL_DOCKER=$( confirm 'Install Docker and add user to docker group?' && echo 1 || echo 0 )
    INSTALL_BLUETOOTH=$( confirm 'Install Bluetooth stack?'                    && echo 1 || echo 0 )
    INSTALL_PRINTING=$( confirm 'Install printing (CUPS) stack?'              && echo 1 || echo 0 )
}

################################################################################
# Step 6: confirmation
################################################################################
review_and_confirm() {
    step "Review configuration"
    cat <<EOF
  ${C_BOLD}Disk:${C_RESET}        ${C_GREEN}$DISK${C_RESET}   (${C_RED}WILL BE WIPED${C_RESET})
  ${C_BOLD}Boot mode:${C_RESET}   $BOOTMODE
  ${C_BOLD}Filesystem:${C_RESET}  $FS
  ${C_BOLD}Hostname:${C_RESET}    $HOSTNAME
  ${C_BOLD}User:${C_RESET}        $USERNAME (groups: wheel,docker,audio,video,input,storage,network)
  ${C_BOLD}Timezone:${C_RESET}    $TIMEZONE
  ${C_BOLD}Locale:${C_RESET}      $LOCALE
  ${C_BOLD}Keymap:${C_RESET}      $KEYMAP
  ${C_BOLD}Docker:${C_RESET}      $( ((INSTALL_DOCKER))    && echo yes || echo no )
  ${C_BOLD}Bluetooth:${C_RESET}   $( ((INSTALL_BLUETOOTH)) && echo yes || echo no )
  ${C_BOLD}Printing:${C_RESET}    $( ((INSTALL_PRINTING))  && echo yes || echo no )

${C_RED}${C_BOLD}This will destroy all data on $DISK.${C_RESET}
EOF
    local ack
    ack="$(ask 'Type FORGE (uppercase) to proceed')"
    [[ $ack == "FORGE" ]] || die "Confirmation phrase not entered; aborting"
}

################################################################################
# Step 7: partition
################################################################################
partition_disk() {
    step "Partitioning $DISK"
    # Wipe everything.
    say "wiping filesystem signatures"
    wipefs -af "$DISK"
    sgdisk --zap-all "$DISK"

    say "creating GPT layout (ESP + root)"
    sgdisk -og "$DISK"
    sgdisk -n 1:0:+1G   -t 1:ef00 -c 1:"EFI System"  "$DISK"
    sgdisk -n 2:0:0     -t 2:8300 -c 2:"FORGE root"  "$DISK"
    partprobe "$DISK"
    sleep 1

    # Figure out partition names (handle nvme/mmc style "p" suffix).
    if [[ $DISK =~ (nvme|mmcblk|loop) ]]; then
        ESP="${DISK}p1"
        ROOT="${DISK}p2"
    else
        ESP="${DISK}1"
        ROOT="${DISK}2"
    fi
    [[ -b $ESP && -b $ROOT ]] || die "partitions did not appear: ESP=$ESP ROOT=$ROOT"
    ok "ESP=$ESP, ROOT=$ROOT"
}

################################################################################
# Step 8: mkfs + mount
################################################################################
make_filesystems() {
    step "Creating filesystems"
    say "ESP: mkfs.fat -F32 -n FORGE-EFI $ESP"
    mkfs.fat -F32 -n FORGE-EFI "$ESP"

    case "$FS" in
        btrfs)
            say "Root: mkfs.btrfs -L FORGE $ROOT"
            mkfs.btrfs -fL FORGE "$ROOT"
            mount "$ROOT" "$MNT"
            btrfs subvolume create "$MNT/@"
            btrfs subvolume create "$MNT/@home"
            btrfs subvolume create "$MNT/@snapshots"
            btrfs subvolume create "$MNT/@var"
            umount "$MNT"

            local opts="rw,noatime,compress=zstd:2,space_cache=v2,discard=async"
            mount -o "$opts,subvol=@"          "$ROOT" "$MNT"
            mkdir -p "$MNT"/{home,.snapshots,var,boot/efi}
            mount -o "$opts,subvol=@home"      "$ROOT" "$MNT/home"
            mount -o "$opts,subvol=@snapshots" "$ROOT" "$MNT/.snapshots"
            mount -o "$opts,subvol=@var"      "$ROOT" "$MNT/var"
            ;;
        ext4)
            say "Root: mkfs.ext4 -L FORGE $ROOT"
            mkfs.ext4 -FL FORGE "$ROOT"
            mount "$ROOT" "$MNT"
            mkdir -p "$MNT/boot/efi"
            ;;
    esac
    mount "$ESP" "$MNT/boot/efi"
}

################################################################################
# Step 9: pacstrap
################################################################################
pacstrap_base() {
    step "Installing base system (pacstrap)"
    local pkgs=(
        base base-devel linux-zen linux-zen-headers linux-firmware
        intel-ucode amd-ucode
        sudo zsh git man-db man-pages
        networkmanager openssh
        grub efibootmgr os-prober
        apparmor pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber
        hyprland waybar dunst rofi-wayland ghostty helix zellij starship
        ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji
        ripgrep fd bat eza btop fzf zoxide lazygit mise
        zram-generator
    )
    case "$FS" in
        btrfs) pkgs+=(btrfs-progs snapper) ;;
        ext4)  pkgs+=(e2fsprogs)            ;;
    esac
    (( INSTALL_DOCKER ))    && pkgs+=(docker docker-buildx docker-compose)
    (( INSTALL_BLUETOOTH )) && pkgs+=(bluez bluez-utils blueman)
    (( INSTALL_PRINTING ))  && pkgs+=(cups cups-pdf system-config-printer)

    pacstrap -K "$MNT" "${pkgs[@]}"

    say "Generating fstab"
    genfstab -U "$MNT" >> "$MNT/etc/fstab"
}

################################################################################
# Step 10: chroot configuration
################################################################################
configure_chroot() {
    step "Configuring system inside chroot"

    # Stage the configuration script so we can edit/lint it before running.
    install -d -m 0755 "$MNT/root"
    cat > "$MNT/root/forge-postinstall.sh" <<'CHROOT_EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
CHROOT_EOF

    cat >> "$MNT/root/forge-postinstall.sh" <<CHROOT_EOF
# Variables injected by forge-install
TIMEZONE='$TIMEZONE'
LOCALE='$LOCALE'
KEYMAP='$KEYMAP'
HOSTNAME='$HOSTNAME'
USERNAME='$USERNAME'
USER_PASSWORD='$PASSWORD'
ROOT_PASSWORD='$ROOT_PASSWORD'
BOOTMODE='$BOOTMODE'
INSTALL_DOCKER=$INSTALL_DOCKER
INSTALL_BLUETOOTH=$INSTALL_BLUETOOTH
INSTALL_PRINTING=$INSTALL_PRINTING
DISK='$DISK'
FS='$FS'
CHROOT_EOF

    cat >> "$MNT/root/forge-postinstall.sh" <<'CHROOT_EOF'

# ---- locale / timezone / hostname
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
hwclock --systohc --utc

sed -i "s/^#\\($LOCALE\\)/\\1/" /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf
echo "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<HOSTS_EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
HOSTS_EOF

# ---- mkinitcpio: systemd-style hooks
sed -i 's|^HOOKS=.*|HOOKS=(base systemd autodetect modconf kms keyboard sd-vconsole block filesystems fsck)|' /etc/mkinitcpio.conf
mkinitcpio -P

# ---- passwords / user
echo "root:$ROOT_PASSWORD" | chpasswd

useradd -m -G wheel,audio,video,input,storage,network -s /usr/bin/zsh "$USERNAME"
echo "$USERNAME:$USER_PASSWORD" | chpasswd

install -d -m 0750 /etc/sudoers.d
cat > /etc/sudoers.d/10-forge-wheel <<SUDO_EOF
%wheel ALL=(ALL:ALL) ALL
Defaults pwfeedback
SUDO_EOF
chmod 0440 /etc/sudoers.d/10-forge-wheel

# ---- skel
if [[ -d /etc/skel ]]; then
    cp -aT /etc/skel "/home/$USERNAME"
    chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"
fi

# ---- services
SERVICES=(NetworkManager systemd-resolved systemd-timesyncd apparmor.service fstrim.timer)
((INSTALL_DOCKER))    && SERVICES+=(docker.socket)
((INSTALL_BLUETOOTH)) && SERVICES+=(bluetooth.service)
((INSTALL_PRINTING))  && SERVICES+=(cups.service)
for s in "${SERVICES[@]}"; do
    systemctl enable "$s" || true
done

# Add user to docker group if applicable.
if ((INSTALL_DOCKER)); then
    usermod -aG docker "$USERNAME" || true
fi

# ---- bootloader
if [[ $BOOTMODE == "uefi" ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=FORGE --recheck
else
    grub-install --target=i386-pc --recheck "$DISK"
fi
sed -i 's|^GRUB_DEFAULT=.*|GRUB_DEFAULT=0|' /etc/default/grub
sed -i 's|^GRUB_TIMEOUT=.*|GRUB_TIMEOUT=3|' /etc/default/grub
if ! grep -q 'lsm=' /etc/default/grub; then
    sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"|GRUB_CMDLINE_LINUX_DEFAULT="\1 lsm=landlock,lockdown,yama,integrity,apparmor,bpf"|' /etc/default/grub
fi
grub-mkconfig -o /boot/grub/grub.cfg

# ---- zram
install -d -m 0755 /etc/systemd
cat > /etc/systemd/zram-generator.conf <<ZRAM_EOF
[zram0]
zram-size = min(ram / 2, 32768)
compression-algorithm = lz4
swap-priority = 100
fs-type = swap
ZRAM_EOF

# ---- yay (AUR helper), built as the new user
pacman -S --needed --noconfirm git base-devel
cat > /etc/sudoers.d/99-forge-yay-build <<'SUDO_YAY_EOF'
${USERNAME} ALL=(ALL) NOPASSWD: /usr/bin/pacman
SUDO_YAY_EOF
chmod 0440 /etc/sudoers.d/99-forge-yay-build

sudo -u "$USERNAME" bash -euo pipefail -c "
    tmp=\$(mktemp -d)
    cd \"\$tmp\"
    git clone --depth=1 https://aur.archlinux.org/yay-bin.git
    cd yay-bin
    makepkg -si --noconfirm
" || echo "WARNING: yay build failed; you can install it later"

rm -f /etc/sudoers.d/99-forge-yay-build

# ---- shell default
chsh -s /usr/bin/zsh "$USERNAME" || true
chsh -s /usr/bin/zsh root        || true

CHROOT_EOF

    chmod +x "$MNT/root/forge-postinstall.sh"
    arch-chroot "$MNT" /root/forge-postinstall.sh 2>&1 | tee -a "$LOG_FILE"
    rm -f "$MNT/root/forge-postinstall.sh"
}

################################################################################
# Step 11: post-install hooks (snapper, etc.)
################################################################################
post_install_hooks() {
    step "Post-install hooks"
    if [[ $FS == "btrfs" ]] && arch-chroot "$MNT" command -v snapper >/dev/null 2>&1; then
        say "Configuring snapper for root"
        arch-chroot "$MNT" bash -c '
            snapper -c root create-config / 2>/dev/null || true
            systemctl enable snapper-timeline.timer snapper-cleanup.timer || true
        '
    fi
    install -d -m 0755 "$MNT/var/cache/forge/snapshots" "$MNT/var/log/forge"
}

################################################################################
# Step 12: finish
################################################################################
finish() {
    step "Finishing up"
    sync
    cat <<EOF

${C_GREEN}${C_BOLD}━━━ Installation complete ━━━${C_RESET}

  Disk        : $DISK
  Hostname    : $HOSTNAME
  Primary user: $USERNAME
  Boot mode   : $BOOTMODE
  Filesystem  : $FS
  Log         : $LOG_FILE

Reboot when ready:
    ${C_AMBER}reboot${C_RESET}

After reboot, remove the install media and log in as ${C_AMBER}$USERNAME${C_RESET}.

EOF
}

################################################################################
# Main
################################################################################
main() {
    banner
    preflight
    select_disk
    select_fs
    select_locale
    select_user
    select_extras
    review_and_confirm
    partition_disk
    make_filesystems
    pacstrap_base
    configure_chroot
    post_install_hooks
    finish
}

main "$@"
